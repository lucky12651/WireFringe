# Server-local copy. Same keys as the root .env.example.
# Copy to server/.env — never commit real secrets.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/wirefringe
BLOG_SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-to-a-long-random-string
DB_CONNECT_TIMEOUT=5
HTTPS_ONLY=false
