# Copy to .env at the repo root (and/or server/.env). Never commit real secrets.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/wirefringe
BLOG_SESSION_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-long-random-string
REVALIDATE_SECRET=change-me-to-a-long-random-string

# --- Optional ---
DB_CONNECT_TIMEOUT=5
HTTPS_ONLY=false
JWT_EXPIRE_MINUTES=10080

# Public site URL used in password-reset and verification links
PUBLIC_SITE_URL=http://127.0.0.1:3000

# Local only. When true, forgot-password and verify-email responses include the link.
DEV_RETURN_AUTH_LINKS=false

# Next.js → API (SSR + proxy)
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000

# AI news bot (optional — only if you enable the bot)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
